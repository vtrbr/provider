async function getTopfilmesFilmes() {
  const data = await getAll();
  return { success: true, data };
}

// ---------- Paginação da resposta ----------
function getPositiveInt(value, fallback) {
  const parsed = Number.parseInt(value, 10);

  return Number.isInteger(parsed) && parsed > 0
    ? parsed
    : fallback;
}

async function handler(req, res) {
  try {
    if (req && req.query && req.query.refresh === '1') {
      cacheData = null;
      cacheAt = 0;
    }

    // Mantém os parâmetros de paginação independentes do scraping.
    const page = getPositiveInt(req?.query?.page, 1);
    const requestedLimit = getPositiveInt(req?.query?.limit, 30);
    const limit = Math.min(requestedLimit, 100);

    // Obtém o catálogo completo do cache ou realiza o scraping.
    const result = await getTopfilmesFilmes();
    const allItems = result.data;

    const total = allItems.length;
    const totalPages = Math.ceil(total / limit);
    const start = (page - 1) * limit;

    // Devolve somente os itens da página solicitada.
    const data = allItems.slice(start, start + limit);

    return res.json({
      success: true,
      data,
      pagination: {
        page,
        limit,
        total,
        totalPages,
        hasNext: page < totalPages,
        hasPrev: page > 1 && page <= totalPages
      }
    });

  } catch (err) {
    console.error(`[${SOURCE}:filmes] error:`, err);

    return res.status(500).json({
      success: false,
      error: err.message
    });
  }
}

module.exports = { handler, getTopfilmesFilmes };
