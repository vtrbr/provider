<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fundo sempre escuro: evita “tela cinza” na abertura e troca de Activity -->
    <style name="Theme.Tedflix" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#050609</item>
        <item name="android:colorBackground">#050609</item>
        <item name="android:statusBarColor">#050609</item>
        <item name="android:navigationBarColor">#050609</item>
        <item name="android:windowAnimationStyle">@style/TedflixWindowAnimation</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Theme.Tedflix.Splash" parent="Theme.Tedflix">
        <item name="android:windowBackground">#050609</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.Tedflix.Player" parent="Theme.Tedflix">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.Tedflix.DownloadResolver" parent="Theme.Tedflix.Player">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.0</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="TedflixWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="TedflixDialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:background">#14151A</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:colorAccent">#E50914</item>
        <item name="android:windowBackground">@drawable/tedflix_dialog_background</item>
    </style>
</resources>
